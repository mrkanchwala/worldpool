[Unit]
Description=WorldPool Telegram prediction-market bot (Quadriga Automations)
Documentation=https://quadrigasolutions.com/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=murtaza
WorkingDirectory=/home/murtaza/worldpool
ExecStart=/home/murtaza/worldpool/.venv/bin/python main.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# NODE_BIN: absolute path to node binary — nvm path not available in systemd env
# Update this if node version changes on VPS (check: nvm which node)
Environment=NODE_BIN=/home/murtaza/.nvm/versions/node/v24.12.0/bin/node

# Hardening (CIE)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/murtaza/worldpool
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
